| 20452.8811 ± 31.9093 | 9055.5809 ± 25.9408 | 1900 |\n| Eu-145 | -5064.8984 ± 19.9521 | 106.4919 ± 14.3036 | 19892.8493 ± 11.4039 | 9608.8022 ± 3.8306 | 1918 |\n| Eu-146 | -1031.7798 ± 7.0750 | 1599.0169 ± 24.3421 | 17641.0646 ± 12.3033 | 10279.4287 ± 6.4848 | 1935 |\n| Eu-147 | -2187.6833 ± 2.5273 | 2991.1370 ± 3.1123 | 15695.7232 ± 3.5906 | 10855.0471 ± 3.1303 | 1952 |\n| Eu-148 | -28.0630 ± 9.9633 | 2693.7185 ± 10.2240 | 15322.5152 ± 11.5724 | 11421.0639 ± 10.7632 | 1968 |\n| Eu-149 | -1314.1437 ± 4.1361 | 2401.2735 ± 4.5706 | 15039.3418 ± 4.4325 | 11977.2749 ± 3.8451 | 1985 |\n| Eu-150 | 971.6815 ± 3.5428 | 2237.0750 ± 6.9649 | 14637.5235 ± 11.7003 | 12504.4349 ± 8.3255 | 2002 |\n| Eu-151 | -464.1779 ± 2.7791 | 1963.9700 ± 1.0664 | 14354.4175 ± 3.7698 | 13166.6358 ± 1.9814 | 2019 |\n| Eu-152 | 1818.8037 ± 0.7002 | 1552.4609 ± 5.6105 | 14238.7666 ± 6.1788 | 13869.1064 ± 20.0076 | 2036 |\n| Eu-153 | -484.5225 ± 0.7150 | 272.0222 ± 1.9861 | 14857.0044 ± 0.1557 | 14559.1484 ± 4.5099 | 2052 |\n| Eu-154 | 1967.9913 ± 0.7535 | -565.9470 ± 20.0092 | 14992.5030 ± 0.2660 | 15061.8405 ± 25.8908 | 2069 |\n| Eu-155 | 251.9612 ± 0.8682 | -856.9927 ± 4.5329 | 14593.5066 ± 0.4651 | 15748.2758 ± 9.1138 | 2085 |\n| Eu-156 | 2452.4891 ± 3.4083 | -1253.2916 ± 26.1051 | 14487.1135 ± 3.3712 | 16394.1840 ± 25.2690 | 2102 |\n| Eu-157 | 1364.7614 ± 4.1973 | -1236.0468 ± 9.9762 | 13783.4334 ± 4.1606 | 17097.0707 ± 6.3290 | 2119 |\n| Eu-158 | 3419.5081 ± 2.2547 | -1428.7750 ± 25.1034 | 13330.2533 ± 4.0746 | 17681.5561 ± 2.3540 | 2136 |\n| Eu-159 | 2518.4717 ± 4.3657 | -1528.2959 ± 6.3761 | 12726.8876 ± 4.1897 | 18324.2119 ± 8.2146 | 2153 |\n| Eu-160 | 4448.6112 ± 1.4417 | -1751.5172 ± 1.4927 | 12365.6235 ± 2.2241 | 18965.2480 ± 1.2667 | 2170 |\n| Eu-161 | 3714.5406 ± 10.5074 | -1919.4011 ± 12.5219 | 11890.8516 ± 11.2485 | 19815.1921 ± 14.4396 | 2187 |\n| Eu-162 | 5557.7761 ± 4.1748 | -2041.7169 ± 1.5858 | 11372.1313 ± 1.5947 | 20406.2473 ± 2.4344 | 2204 |\n| Eu-163 | 4814.7720 ± 1.2046 |