{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded thermal source-availability review; no physical values accepted",
  "type": "object",
  "required": ["registry_id", "record_id", "status", "source_ids", "source_review", "heat_capacity", "derived_tables_and_charts", "scientific_completion"],
  "properties": {
    "registry_id": {"type": "string", "pattern": "^MAT:[0-9]{4}:REG:THERMOCHEMISTRY-SOURCE-REVIEW$"},
    "record_id": {"type": "string", "pattern": "^MAT:[0-9]{4}$"},
    "status": {"const": "INSUFFICIENT DATA"},
    "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}},
    "heat_capacity": {
      "type": "object", "required": ["value", "unit", "status", "uncertainty", "reason"],
      "properties": {"value": {"type": "null"}, "unit": {"const": "J mol^-1 K^-1"}, "status": {"const": "INSUFFICIENT DATA"}, "uncertainty": {"const": "UNKNOWN"}, "reason": {"type": "string", "minLength": 1}}
    },
    "source_review": {
      "type": "object", "required": ["source_id", "retrieved", "snapshot", "coverage_index", "fit_count", "source_review_result", "scope", "next_action"],
      "properties": {"fit_count": {"const": 0}, "source_review_result": {"const": "NO-SHOMATE-IN-RETAINED-PAGE"}, "scope": {"type": "string", "minLength": 1}, "next_action": {"type": "string", "minLength": 1}}
    },
    "derived_tables_and_charts": {"const": "NOT-GENERATED; NO-ACCEPTED-FIT"},
    "scientific_completion": {"const": "PENDING"}
  }
}
