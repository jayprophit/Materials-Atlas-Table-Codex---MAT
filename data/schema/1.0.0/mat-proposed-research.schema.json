{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAT proposed-element research queue (no accepted physical claims)",
  "type": "object",
  "required": [
    "schema_version",
    "entry_id",
    "atomic_number",
    "name",
    "symbol",
    "recognition_status",
    "recognition_checked",
    "source_ids",
    "identity",
    "completion",
    "fully_advanced",
    "domains",
    "research_layers",
    "state_flow",
    "visual_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^MAT-PROPOSED:0(1[1-8][0-9])$"
    },
    "atomic_number": {
      "type": "integer",
      "minimum": 119,
      "maximum": 188
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{2}$"
    },
    "recognition_status": {
      "const": "PROPOSED-NOT-RECOGNISED"
    },
    "recognition_checked": {
      "type": "string",
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-\\d{6}$"
      }
    },
    "identity": {
      "type": "object"
    },
    "completion": {
      "const": "PENDING-SCIENTIFIC-REVIEW"
    },
    "fully_advanced": {
      "const": false
    },
    "domains": {
      "type": "object",
      "minProperties": 36,
      "maxProperties": 36,
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "applicability",
          "claims",
          "review_status",
          "scope"
        ],
        "properties": {
          "status": {
            "const": "UNKNOWN"
          },
          "applicability": {
            "const": "INSUFFICIENT DATA"
          },
          "claims": {
            "type": "array",
            "maxItems": 0
          },
          "review_status": {
            "const": "PENDING"
          },
          "scope": {
            "type": "string",
            "minLength": 20
          }
        },
        "additionalProperties": false
      }
    },
    "research_layers": {
      "type": "object",
      "required": [
        "published_predictions",
        "author_proposed",
        "historical"
      ],
      "additionalProperties": {
        "type": "array",
        "maxItems": 0
      }
    },
    "state_flow": {
      "type": "object",
      "required": [
        "profile",
        "requirement_count",
        "default_status",
        "overrides"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "requirement_count": {
          "type": "integer",
          "minimum": 1
        },
        "default_status": {
          "const": "UNKNOWN"
        },
        "overrides": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "visual_plan": {
      "type": "object",
      "required": [
        "minimum_images",
        "panels"
      ],
      "properties": {
        "minimum_images": {
          "const": 22
        },
        "panels": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {
            "type": "object",
            "required": [
              "panel_id",
              "status",
              "asset_path"
            ],
            "properties": {
              "panel_id": {
                "type": "string",
                "pattern": "^(A0[1-9]|B0[1-9]|B1[0-3])$"
              },
              "status": {
                "const": "PENDING-SCIENTIFIC-SCOPE-AND-ASSET"
              },
              "asset_path": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  }
}
