{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mat-codex.local/schema/1.0.0/mat-reading-projection.schema.json",
  "title": "Bounded MAT reading projection",
  "description": "Additive read-only view of a canonical metric; no new physical record or acceptance status is created.",
  "type": "object",
  "required": ["binding_id", "owner", "object_ref", "state", "metric", "value", "unit", "uncertainty", "uncertainty_status", "evidence_type", "conditions", "provenance", "acceptance", "limitations"],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "owner": {"const": "MAT:0001"},
    "object_ref": {"enum": ["MAT:0001:ATOM:H", "MAT:0001:MOL:H2"]},
    "state": {"type": "object", "required": ["species"]},
    "metric": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "unit": {"enum": ["Hz", "K", "eV"]},
    "uncertainty": {"type": ["number", "null"], "minimum": 0},
    "uncertainty_status": {"enum": ["UNKNOWN", "REPORTED-IN-OWNER"]},
    "evidence_type": {"enum": ["MEASURED", "REPLICATED", "THEORETICAL", "COMPUTATIONAL", "EARLY-EXPERIMENTAL", "HISTORICAL", "HYPOTHESIS", "UNVERIFIED", "ESTABLISHED", "EVALUATED", "DERIVED"]},
    "conditions": {"type": "object", "minProperties": 1},
    "provenance": {"type": "object", "required": ["path", "pointer", "source_id", "source_locator"], "properties": {"path": {"type": "string"}, "pointer": {"type": "string", "pattern": "^/"}, "source_id": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}, "source_locator": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"]}}, "additionalProperties": false},
    "acceptance": {"const": "SOURCE-BOUND-CANDIDATE; INDEPENDENT-REVIEW-PENDING"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "derived_period": {"type": "object", "required": ["value", "unit", "equation", "evidence_type", "uncertainty", "uncertainty_status", "assumption"], "properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "s"}, "equation": {"const": "T = 1 / frequency"}, "evidence_type": {"const": "DERIVED"}, "uncertainty": {"type": ["number", "null"], "minimum": 0}, "uncertainty_status": {"enum": ["UNKNOWN", "FIRST-ORDER-PROPAGATED"]}, "assumption": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
