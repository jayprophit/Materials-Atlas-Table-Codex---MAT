* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.glb binary
*.zip binary
*.pdf binary
# Accession hashes refer to the exact original bytes, including line endings.
archive/source-intake/**/*.txt -text
data/catalog/sources/nubase_4.mas20.txt -text
data/catalog/sources/ame2020-*.mas20.txt -text -whitespace
data/catalog/sources/nist-asd-*-2026-09-14.* -text
# Retained NIST CSV bytes include source-supplied trailing spaces and final blanks.
# Integrity is checked by SHA-256; do not reformat the authoritative snapshot.
data/catalog/sources/nist-asd-ionisation-2026-09-14.csv -whitespace
archive/source-intake/integration-2026-09-14/* -text

# Retained web source bytes are inert text snapshots, never executed.
data/catalog/sources/nist-hydrogen-*.html.txt -text -whitespace

data/catalog/sources/nist-water-*.html.txt -text -whitespace

data/catalog/sources/nist-thermochemistry-*.html.txt -text -whitespace

# Owner-supplied reference retained as exact inert bytes; never execute its text.
data/research/sources/mat-update-2026-09-29.txt -text -whitespace
# The owner-supplied handoff transcripts are accessions too. Their recorded
# hashes are of the exact original bytes, CRLF line endings included, and
# they are checked by a raw SHA-256 of the file as it is on disk. Without
# -text the checkout normalises them to LF, the recorded hash stops
# matching, and the check fails on a clean checkout and only there.
data/research/sources/mat-knowledge-handoff-2026-10-03.txt -text
data/research/sources/mat-universal-coverage-2026-10-03.txt -text
# Definition migration origins are checked against their preserved byte hashes.
data/research/sources/mat-glossary-prose-2026-10-03.md -text
data/research/sources/mat-hover-glossary-2026-10-03.json -text
